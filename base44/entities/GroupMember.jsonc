{
  "name": "GroupMember",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending"
      ],
      "default": "active"
    }
  },
  "required": [
    "group_id",
    "user_email"
  ]
}